# Copiá este archivo a ".env" (sin el ".example") y completá los valores
# reales antes de levantar el proyecto con docker-compose en el VPS.
# NUNCA subas el archivo ".env" real a GitHub -- solo este ejemplo.

# --- Base de datos ---
POSTGRES_PASSWORD=elegí-una-contraseña-larga-y-random-acá

# --- Seguridad (generalos con: python3 -c "import secrets; print(secrets.token_hex(32))") ---
SECRET_KEY=
# Este con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Cuenta admin de Facturea (se crea sola al arrancar, si no existe) ---
ADMIN_EMAIL=vos@tu-email.com
ADMIN_PASSWORD=una-contraseña-fuerte

# --- Google Drive por cliente (sacar de Google Cloud Console, ver DEPLOY.md) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Tiene que ser EXACTO a lo que cargaste en Google Cloud Console, con el dominio real:
GOOGLE_OAUTH_REDIRECT_URI=https://tu-dominio.com/google-drive/callback
