+async function generarTokenGestion(empresaId, yaConectado) {
+  if (yaConectado && !confirm('Si generás un código nuevo, el anterior deja de funcionar y vas a tener que pegar el nuevo en el sistema de gestión. ¿Seguir?')) return;
+  try {
+    const r = await fetch(`/empresas/${empresaId}/api-externa/token`, { method: 'POST' });
+    const d = await r.json();
+    if (!d.ok) { alert(d.error || 'No se pudo generar el código.'); return; }
+    document.getElementById('tokenGestionValor').value = d.token;
+    document.getElementById('tokenGestion').style.display = 'block';
+  } catch (e) {
+    alert('No se pudo conectar con el servidor.');
+  }
+}
+
+async function revocarTokenGestion(empresaId) {
+  if (!confirm('¿Desconectar el sistema de gestión? Sus ventas van a dejar de llegar a esta empresa.')) return;
+  try {
+    const r = await fetch(`/empresas/${empresaId}/api-externa/revocar`, { method: 'POST' });
+    if (r.ok) window.location.reload(); else alert('No se pudo desconectar. Probá de nuevo.');
+  } catch (e) {
+    alert('No se pudo conectar con el servidor.');
+  }
+}
